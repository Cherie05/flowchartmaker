{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wizzleflow",
  "compatibility_date": "2026-07-20",
  "main": "worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "f9e371d0eb134f56bbafe7c320da73f5"
    }
  ]
}
