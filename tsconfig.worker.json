{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true
  },
  "include": [
    "worker/**/*.ts",
    "server/middleware/errorHandler.ts",
    "server/services/diagramGenerationService.ts",
    "server/providers/geminiFlowchartProvider.ts",
    "shared/**/*.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
