# ==========================================
# REQUIRED: AI Flowchart Generation API Key
# ==========================================
# Provide ONE of the following API keys and comment out the other.
# By default, Gemini is used. If using OpenAI, comment out Gemini and uncomment OpenAI.

# --- Option 1: Google Gemini (Default) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Option 2: OpenAI (Build Week) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ==========================================
# Optional AI Configuration
# ==========================================
AI_REQUEST_TIMEOUT_MS=30000
AI_DAILY_LIMIT=3
AI_COOLDOWN_SECONDS=20
AI_MAX_PROMPT_LENGTH=2000
AI_MAX_NODES=25
AI_MAX_EDGES=40
